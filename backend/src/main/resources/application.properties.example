# Copie os valores reais para variaveis de ambiente antes de rodar em qualquer
# lugar que nao seja sua maquina local com o docker-compose deste repo.
# Nenhum destes valores deve ser commitado com dado real.

# Banco de dados (default local bate com docker-compose.yml)
DB_USERNAME=smartdocs
DB_PASSWORD=smartdocs123
# Só precisa mudar se estiver fora do docker-compose (ex: rodando a app local
# apontando pro banco de outro host, ou um Postgres gerenciado tipo Neon).
# Dentro do compose isso vira "postgres".
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartdocs
# Só necessário contra um Postgres gerenciado que exige TLS (ex: Neon):
# DB_SSLMODE=require

# RabbitMQ (default local bate com docker-compose.yml)
RABBITMQ_USERNAME=smartdocs
RABBITMQ_PASSWORD=smartdocs123
# Mesma ideia do DB_HOST. Dentro do compose isso vira "rabbitmq".
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
# Só necessário contra um RabbitMQ gerenciado que exige AMQPS (ex: CloudAMQP -
# nesse caso RABBITMQ_PORT também vira 5671):
# RABBITMQ_SSL_ENABLED=true

# JWT - gere um valor novo e aleatorio de pelo menos 32 bytes para producao.
# Exemplo de geracao: openssl rand -base64 32
JWT_SECRET=troque-este-valor-antes-de-subir-em-qualquer-ambiente-real

# Groq API (roda o modelo Llama 3.3 70B) - gratuito, sem cartao, em
# https://console.groq.com
GROQ_API_KEY=gsk-sua-chave-aqui
GROQ_MODEL=llama-3.3-70b-versatile

# Tempo maximo (segundos) pra extrair texto + analisar um documento antes de
# desistir e deixar o RabbitMQ tentar de novo. Protege contra um PDF malicioso
# que trava o parser do PDFBox.
PROCESSING_TIMEOUT_SECONDS=60
